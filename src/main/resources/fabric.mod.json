{
  "schemaVersion": 1,
  "id": "default_components",
  "version": "${version}",

  "name": "Default Components",
  "description": "Change the default components of any item in the game",
  "authors": [],
  "contact": {},

  "license": "GPL-3.0",
  "icon": "assets/default_components/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.awakenedredstone.defaultcomponents.DefaultComponents"
    ],
    "client": [
      "com.awakenedredstone.defaultcomponents.DefaultComponentsClient"
    ]
  },

  "accessWidener": "${accessWidener}",
  "mixins": [
    "default_components.mixins.json"
  ],

  "depends": {
    "fabricloader": "*",
    "fabric-api": "*",
    "minecraft": "${minecraft}"
  }
}
